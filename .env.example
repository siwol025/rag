# PostgreSQL (docker compose)
POSTGRES_USER=slack_rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=slack_rag

# FastAPI · 워커
# 로컬에서 uv run으로 띄울 때 쓰는 값. compose의 api·worker 컨테이너는 docker-compose.yml에서 덮어씀
DATABASE_URL=postgresql://slack_rag:change-me@localhost:5432/slack_rag
REDIS_URL=redis://localhost:6380/0
# openssl rand -hex 32 로 생성. n8n Header Auth 자격 증명의 Value에도 같은 값
JOBS_API_KEY=
# 대상 채널 ID JSON 배열(작은따옴표로 감쌈)
SLACK_TARGET_CHANNEL_IDS='["C0123456789"]'

# n8n: 터널 주소(끝에 / 포함)
N8N_WEBHOOK_URL=https://example.trycloudflare.com/

# Gemini API(AI Studio) — 무료 요금제, 결제 계정을 연결하지 않은 프로젝트의 키만(TO-008). 비밀값
GEMINI_API_KEY=
# 역할 → 모델 ID(TO-007). 경량: 요청 분류
LLM_LIGHT_MODEL=gemini-3.5-flash-lite
# 다음 변수는 설정하지 않는다:
#   LANGSMITH_TRACING, LANGSMITH_TRACING_V2, LANGCHAIN_TRACING, LANGCHAIN_TRACING_V2 → 켜면 메시지 본문이 LangSmith로 전송됨
#   GOOGLE_GEMINI_BASE_URL → 요청(API 키 헤더 포함)이 다른 호스트로 갈 수 있음
#   GOOGLE_GENAI_USE_VERTEXAI, GOOGLE_GENAI_USE_ENTERPRISE → Vertex 경로(코드는 enterprise=False로 막음)
